digraph policy {
  fontname="Helvetica"; node [fontcolor="#1E2A33", fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#EDF0F3", color="#2B3A46"]; edge [fontcolor="#1E2A33", fontname="Helvetica", fontsize=9, color="#2B3A46"];
  start [label="The function raises\nan exception"];
  match [label="Is the exception\nin the handled classes?", shape=diamond, fillcolor="#FDEBB5"];
  pass [label="The exception continues\nwithout a record", fillcolor="#F7D9DD"];
  rec [label="1. Record the exception\n(report)"];
  cb [label="2. Call on_error\n(if given)"];
  wrap [label="Is wrap given?", shape=diamond, fillcolor="#FDEBB5"];
  new [label="3. Raise the new exception\nfrom the initial exception", fillcolor="#F7D9DD"];
  re [label="Is reraise True?", shape=diamond, fillcolor="#FDEBB5"];
  again [label="4. Raise the initial\nexception again", fillcolor="#F7D9DD"];
  dflt [label="5. Return default", fillcolor="#DCEFE3"];
  start -> match; match -> pass [label="No"]; match -> rec [label="Yes"]; rec -> cb; cb -> wrap;
  wrap -> new [label="Yes"]; wrap -> re [label="No"]; re -> again [label="Yes"]; re -> dflt [label="No"];
}
