digraph recorder {
  rankdir=LR; fontname="Helvetica"; node [fontcolor="#1E2A33", fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#EDF0F3", color="#2B3A46"]; edge [fontcolor="#1E2A33", fontname="Helvetica", fontsize=9, color="#2B3A46"];
  rec [label="Record"];
  q1 [label="Severity is the\nfile level or higher?", shape=diamond, fillcolor="#FDEBB5"];
  mem [label="Keep the record\nin memory\n(last N records)", shape=cylinder, fillcolor="#FDEBB5"];
  q2 [label="Severity is the\ntrigger or higher?", shape=diamond, fillcolor="#FDEBB5"];
  flush [label="Write the kept\nrecords first\n(ANN-I-0340)", fillcolor="#F7D9DD"];
  file [label="Log file", fillcolor="#DCEFE3"];
  rec -> q1; q1 -> mem [label="No"]; q1 -> q2 [label="Yes"]; q2 -> file [label="No"]; q2 -> flush [label="Yes"]; flush -> file; mem -> flush [style=dashed];
}
