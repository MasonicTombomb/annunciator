% annunciatortheme.sty -- panel style of the PDF form of the manual.
%
% docs/conf.py loads this package in the LaTeX preamble, after the package
% "sphinx". Before it loads the package, conf.py defines these macros:
%   \anndocnumber  \annissue  \anndate  \annversion  \annsubtitle
% The colours and the logo come from annunciatorlogo.sty.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{annunciatortheme}[2026/11/20 annunciator panel style for Sphinx]
\RequirePackage{annunciatorlogo}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}

% -- Fonts -----------------------------------------------------------------
% Headings: Roboto Condensed Bold. Body text: Latin Modern (fontpkg).
\newcommand*\annheadfont{\annwordfont}
\newcommand*\annheadfontregular{%
  \fontencoding{T1}\fontfamily{Roboto-LF}\fontseries{condensed}%
  \fontshape{n}\selectfont}
\renewcommand*\py@HeaderFamily{\annheadfont}

% -- Colours of Sphinx elements --------------------------------------------
\sphinxsetup{%
  TitleColor={HTML}{1E2A33},
  InnerLinkColor={HTML}{8F5B00},
  OuterLinkColor={HTML}{2F6FA3},
  TableRowColorHeader={HTML}{1E2A33},
  TableRowColorOdd={HTML}{FFFFFF},
  TableRowColorEven={HTML}{F6F4EF},
  pre_background-TeXcolor={HTML}{F5F3EE},
  pre_border-TeXcolor={HTML}{D5CFC0},
  % Notes: advisory blue.
  div.note_border-TeXcolor={HTML}{2F6FA3},
  div.note_background-TeXcolor={HTML}{F3F7FB},
  div.note_title-background-TeXcolor={HTML}{2F6FA3},
  div.note_title-foreground-TeXcolor={HTML}{FFFFFF},
  div.seealso_border-TeXcolor={HTML}{5B6B78},
  div.seealso_title-background-TeXcolor={HTML}{5B6B78},
  div.seealso_title-foreground-TeXcolor={HTML}{FFFFFF},
  % Warnings: lamp amber.
  div.warning_border-TeXcolor={HTML}{F5A800},
  div.warning_background-TeXcolor={HTML}{FFF8E5},
  div.warning_title-background-TeXcolor={HTML}{F5A800},
  div.warning_title-foreground-TeXcolor={HTML}{1E2A33},
  div.important_border-TeXcolor={HTML}{F5A800},
  div.important_background-TeXcolor={HTML}{FFF8E5},
  div.important_title-background-TeXcolor={HTML}{F5A800},
  div.important_title-foreground-TeXcolor={HTML}{1E2A33},
  div.attention_border-TeXcolor={HTML}{F5A800},
  div.attention_background-TeXcolor={HTML}{FFF8E5},
  div.attention_title-background-TeXcolor={HTML}{F5A800},
  div.attention_title-foreground-TeXcolor={HTML}{1E2A33},
  % Cautions and dangers: alarm red.
  div.caution_border-TeXcolor={HTML}{C8102E},
  div.caution_background-TeXcolor={HTML}{FCEEF0},
  div.caution_title-background-TeXcolor={HTML}{C8102E},
  div.caution_title-foreground-TeXcolor={HTML}{FFFFFF},
  div.danger_border-TeXcolor={HTML}{C8102E},
  div.danger_background-TeXcolor={HTML}{FCEEF0},
  div.danger_title-background-TeXcolor={HTML}{C8102E},
  div.danger_title-foreground-TeXcolor={HTML}{FFFFFF},
